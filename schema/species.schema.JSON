{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "SpeciesSchema",
  "type": "object",

  "required": [
    "name",
    "origin",
    "base_desc",
    "appearance_desc",
    "size",
    "speed",
    "features"
  ],

  "properties": {
    "name": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "base_desc": {
      "type": "string"
    },
    "appearance_desc": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "speed": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "properties": {
        "name" : {"type": "string"}
      }
    }
  }
}
