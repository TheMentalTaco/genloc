{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "StatBlockSchema",
  "type": "object",

  "required": [
    "name",
    "type",
    "ac",
    "max_hp",
    "current_hp",
    "temp_hp",
    "speed",
    "stats",
    "dmg_res",
    "dmg_vuln",
    "dmg_immune",
    "conditions_immune",
    "bps",
    "cr",
    "traits",
    "actions"
  ],

  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "ac": {
      "type": "integer",
      "minimum": 0
    },
    "max_hp": {
      "type": "integer",
      "minimum": 1
    },
    "current_hp": {
      "type": "integer",
      "minimum": 0
    },
    "temp_hp": {
      "type": "integer",
      "minimum": 0
    },
    "speed": {
      "type": "object",
      "properties": {
        "walk": { "type": "integer", "minimum": 0 },
        "fly": { "type": "integer", "minimum": 0 },
        "swim": { "type": "integer", "minimum": 0 },
        "climb": { "type": "integer", "minimum": 0 },
        "burrow": { "type": "integer", "minimum": 0 }
      },
      "required": ["walk", "fly", "swim", "climb", "burrow"]
    },
    "stats": {
      "type": "object",
      "properties": {
        "str": { "type": "integer", "minimum": 0 },
        "dex": { "type": "integer", "minimum": 0 },
        "con": { "type": "integer", "minimum": 0 },
        "int": { "type": "integer", "minimum": 0 },
        "wis": { "type": "integer", "minimum": 0 },
        "cha": { "type": "integer", "minimum": 0 }
      },
      "required": ["str", "dex", "con", "int", "wis", "cha"]
    },
    "dmg_res": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dmg_vuln": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dmg_immune": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conditions_immune": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cr": {
      "type": "number",
      "minimum": 0
    },
    "traits": {
      "type": "array",
      "properties": {
        "name": { "type": "string"}
      }
    },
    "actions": {
      "type": "array",
      "properties": {
        "name": { "type": "string"}
      }
      }
    }
  }

