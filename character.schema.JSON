{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "CharacterSchema",
  "type": "object",

  "required": [
    "category",
    "name",
    "title",
    "location",
    "species",
    "languages",
    "base_desc",
    "age",
    "life_status",
    "pronouns",
    "equipment",
    "appearance_desc",
    "personality_desc",
    "affiliations",
    "player_visible",
    "kanka_id",
    "image_url",
    "articles"
  ],

  "properties": {
    "category": {
      "type": "string",
      "enum": ["pc", "npc"]
    },
    "player_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "base_desc": {
      "type": "string"
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "life_status": {
      "type": "string"
    },
    "pronouns": {
      "type": "string"
    },
    "equipment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "appearance_desc": {
      "type": "string"
    },
    "personality_desc": {
      "type": "string"
    },
    "affiliations": {
      "type": "object",
      "properties": {
        "org": { "type": "string" },
        "position": { "type": "string" },
        "org_status": { "type": "string" }
      }
    },
    "player_visible": {
      "type": "boolean"
    },
    "kanka_id": {
      "type": "integer"
    },
    "image_url": {
      "type": "string",
      "format": "url"
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "string",
            "description": "Markdown or HTML text"
          },
          "is_private": { "type": "boolean", "default": false }
        },
        "required": ["title", "content"]
      }
    }
  }
}
